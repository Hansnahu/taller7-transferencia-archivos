{
  "name": "Taller Transferencia de Archivos - Flask",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r server/requirements.txt && python server/create_sample_file.py",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Flask API",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
